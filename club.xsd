<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="T_Email">
  <xs:restriction base="xs:string">
  <xs:pattern value="[^@]+@[^\.]+\..+"/>
  </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="T_Complexite">
  <xs:restriction base="xs:integer">
  <xs:minInclusive value="0"/>
  <xs:maxInclusive value="100"/>
  </xs:restriction>
  </xs:simpleType>

  <xs:element name="club">
  <xs:complexType>
  <xs:sequence>
        
  <xs:element name="categories">
  <xs:complexType>
  <xs:sequence>
  <xs:element name="categorie" maxOccurs="unbounded">
  <xs:complexType>
  <xs:attribute name="id" type="xs:ID" use="required"/>
  <xs:attribute name="libelle" type="xs:string" use="required"/>
  </xs:complexType>
  </xs:element>
  </xs:sequence>
  </xs:complexType>
  </xs:element>

  <xs:element name="membres">
  <xs:complexType>
<xs:sequence>
<xs:element name="membre" maxOccurs="unbounded">
  <xs:complexType>
  <xs:sequence>
  <xs:element name="nom" type="xs:string"/>
  <xs:element name="prenom" type="xs:string"/>
  <xs:element name="email" type="T_Email"/>
  </xs:sequence>
  <xs:attribute name="id" type="xs:ID" use="required"/>
  <xs:attribute name="categorieRef" type="xs:IDREF" use="required"/>
  </xs:complexType>
  </xs:element>
 </xs:sequence>
  </xs:complexType>
  </xs:element>

<xs:element name="concours">
<xs:complexType>
<xs:sequence>
<xs:element name="concours" maxOccurs="unbounded">
<xs:complexType>
<xs:sequence>
<xs:element name="titre" type="xs:string"/>
 <xs:element name="participants">
<xs:complexType>
<xs:sequence>
<xs:element name="participant" maxOccurs="unbounded">
 <xs:complexType>
<xs:sequence>
<xs:element name="complexite" type="T_Complexite"/>
<xs:element name="tempsExecution" type="xs:positiveInteger"/>
</xs:sequence>
<xs:attribute name="membreRef" type="xs:IDREF" use="required"/>
 </xs:complexType>
</xs:element>
</xs:sequence>
 </xs:complexType>
</xs:element>
</xs:sequence>
<xs:attribute name="id" type="xs:ID" use="required"/>
<xs:attribute name="categorieRef" type="xs:IDREF" use="required"/>
 <xs:attribute name="date" type="xs:date" use="required"/>
<xs:attribute name="coefficient" type="xs:decimal" use="required"/>
</xs:complexType>
</xs:element>
</xs:sequence>
</xs:complexType>
</xs:element>

</xs:sequence>
<xs:attribute name="nom" type="xs:string" use="required"/>
</xs:complexType>
</xs:element>

</xs:schema>